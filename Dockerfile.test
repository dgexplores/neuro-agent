FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements-lambda.txt requirements-test.in ./
RUN pip install --no-cache-dir --only-binary=:all: -r requirements-lambda.txt -r requirements-test.in
COPY backend/ ./backend/
COPY tests/ ./tests/
COPY data/ ./data/
COPY pyproject.toml ./
CMD ["sh", "-c", "exec timeout --signal=ABRT --kill-after=10s 120s python -X faulthandler -m pytest backend/tests tests/test_*.py --timeout=45 --timeout-method=thread --junitxml=/reports/backend.xml"]
