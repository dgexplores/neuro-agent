# AWS: prefer your normal credential provider chain or AWS_PROFILE.
AWS_REGION=us-east-1
# AWS_PROFILE=your_profile
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Bedrock (requires access to this model in your account and region)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# Optional legacy Bedrock Agents interface; direct assessments use the model above.
# BEDROCK_AGENTCORE_AGENT_ID=your_agent_id

# Local synthetic case storage. Cloud CDK sets dynamodb instead.
CASE_STORE_BACKEND=sqlite
CASE_DB_PATH=data/cases.sqlite3
# DYNAMODB_TABLE_NAME=your_cases_table
# Optional encrypted image upload after successful model analysis.
# S3_BUCKET_NAME=your_images_bucket

# Replace with your own private secret; never put it into frontend settings.
JWT_SECRET_KEY=replace_with_a_generated_private_secret
ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Put this in frontend/.env.local for a local React build.
# REACT_APP_API_URL=http://localhost:8000
